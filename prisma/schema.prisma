// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────

enum ParticipantStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BonusPosition {
  CHAMPION
  BEST_PLAYER
  TOP_SCORER
  BEST_YOUNG_PLAYER
}

// ─── Sponsor Codes ────────────────────────────────────────────

model SponsorCode {
  id           String        @id @default(cuid())
  code         String        @unique
  sponsorName  String
  maxUses      Int           @default(10)
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())

  participants Participant[]
}

// ─── Participants ─────────────────────────────────────────────

model Participant {
  id               String            @id @default(cuid())
  name             String
  email            String?           @unique
  passwordHash     String?
  phone            String?           @unique
  pin              String?
  status           ParticipantStatus @default(PENDING)
  sponsorCodeId    String?
  paymentReference String?
  pricePaid        Int?
  createdAt        DateTime          @default(now())
  approvedAt       DateTime?
  hasSeenWelcome      Boolean           @default(false)
  accessRequestedAt   DateTime?

  sponsorCode      SponsorCode?      @relation(fields: [sponsorCodeId], references: [id])
  predictions      Prediction[]
  bonusPredictions BonusPrediction[]
}

// ─── Tournament ───────────────────────────────────────────────

model Tournament {
  id           String    @id @default(cuid())
  name         String
  firstMatchAt DateTime?
  champion       String?
  bestPlayer     String?
  topScorer      String?
  bestYoungPlayer String?
  createdAt    DateTime  @default(now())

  matches          Match[]
  bonusPredictions BonusPrediction[]
}

// ─── Matches ──────────────────────────────────────────────────

model Match {
  id              String    @id @default(cuid())
  tournamentId    String
  externalId      Int?      @unique
  round           String
  homeTeam        String
  awayTeam        String
  scheduledAt     DateTime
  homeScore       Int?
  awayScore       Int?
  resultEnteredAt DateTime?
  createdAt       DateTime  @default(now())

  tournament  Tournament   @relation(fields: [tournamentId], references: [id])
  predictions Prediction[]
}

// ─── Predictions ──────────────────────────────────────────────

model Prediction {
  id            String   @id @default(cuid())
  participantId String
  matchId       String
  homeScore     Int
  awayScore     Int
  points        Int?
  submittedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  participant Participant @relation(fields: [participantId], references: [id])
  match       Match       @relation(fields: [matchId], references: [id])

  @@unique([participantId, matchId])
}

// ─── Bonus Predictions ────────────────────────────────────────

model BonusPrediction {
  id            String        @id @default(cuid())
  participantId String
  tournamentId  String
  position      BonusPosition
  teamName      String
  points        Int?
  updatedAt     DateTime      @updatedAt

  participant Participant @relation(fields: [participantId], references: [id])
  tournament  Tournament  @relation(fields: [tournamentId], references: [id])

  @@unique([participantId, tournamentId, position])
}

// ─── Players ──────────────────────────────────────────────────
// Squads imported from football-data.org (/competitions/WC/teams).
// Feeds the bonus prediction dropdowns (best player, top scorer,
// best young player). Stored as a flat list; bonus picks reference
// players by name to match the existing BonusPrediction.teamName field.

model Player {
  id          String    @id @default(cuid())
  externalId  Int       @unique
  name        String
  position    String?
  dateOfBirth DateTime?
  nationality String?
  teamName    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([teamName])
}
